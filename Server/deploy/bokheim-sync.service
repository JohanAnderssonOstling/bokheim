[Unit]
Description=Bokheim synchronization server
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=exec
User=bokheim
Group=bokheim
WorkingDirectory=/var/lib/bokheim
ExecStart=/usr/local/bin/sync-server
Environment=SYNC_SERVER_SOCKET=/run/bokheim/sync.sock
Environment=RUST_LOG=info
Environment=BOKHEIM_UPLOAD_BYTES_PER_SECOND=104857600
Environment=BOKHEIM_DOWNLOAD_BYTES_PER_SECOND=104857600
Environment=BOKHEIM_TRANSFER_BURST_BYTES=1048576
LoadCredential=database_url:/etc/bokheim/database-url
LoadCredential=admin_password:/etc/bokheim/admin-password

RuntimeDirectory=bokheim
RuntimeDirectoryMode=0750
StateDirectory=bokheim
StateDirectoryMode=0750
UMask=0007

Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
