{
  "name": "mobileapp",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "BOKHEIM_FRONTEND_OUT_DIR=dist vite build",
    "preview": "vite preview",
    "demo": "vite --host 0.0.0.0",
    "build:demo": "BOKHEIM_FRONTEND_OUT_DIR=dist vite build",
    "build:web-algorithms": "cargo build --release --target wasm32-unknown-unknown --manifest-path ../BokheimWebAlgorithms/Cargo.toml && node scripts/install-web-algorithms.mjs",
    "dev:web": "npm run build:web-algorithms && vite --mode web",
    "build:web": "npm run build:web-algorithms && BOKHEIM_FRONTEND_OUT_DIR=dist-web vite build --mode web",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:cfi": "node scripts/check-cfi-parity.mjs",
    "test:catalog": "node --test src/lib/catalog.test.ts",
    "test:catalog-cache": "node --test src/lib/catalog-page-cache.test.ts",
    "test:semantic-links": "node --test src/lib/semantic-links.test.ts",
    "test:browsing-contract": "node --test src/lib/browsing-contract.test.ts",
    "test:account-contract": "node --test src/lib/account-contract.test.ts",
    "test:web-algorithms": "npm run build:web-algorithms && node scripts/check-web-algorithms.mjs",
    "generate:bindings": "cargo run --manifest-path src-tauri/Cargo.toml --bin export_bindings",
    "check:bindings": "cargo run --manifest-path src-tauri/Cargo.toml --bin export_bindings -- --check",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.6.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
