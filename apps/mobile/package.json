{
  "name": "mobileapp",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "BOKHEIM_BACKEND=web vite dev",
    "dev:native": "BOKHEIM_BACKEND=native vite dev",
    "build:web-core": "node scripts/build-web-core.mjs",
    "build": "npm run build:web",
    "build:web": "npm run build:web-core && BOKHEIM_BACKEND=web BOKHEIM_FRONTEND_OUT_DIR=dist vite build && npm run precompress",
    "build:native": "BOKHEIM_BACKEND=native BOKHEIM_FRONTEND_OUT_DIR=dist vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{svelte,ts,js,html,css}\" \"design/**/*.html\"",
    "format:check": "prettier --check \"src/**/*.{svelte,ts,js,html,css}\" \"design/**/*.html\"",
    "check": "npm run format:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:cfi": "node scripts/check-cfi-parity.mjs",
    "test:catalog": "node --test src/routes/store/catalog/actions.test.ts",
    "test:semantic-links": "node --test src/lib/shared/semantic-links.test.ts",
    "test:browsing-contract": "node --test src/lib/shared/browsing-contract.test.ts",
    "test:ui-session": "node --test src/lib/session/ui-session.test.ts",
    "test:navigation": "node --test src/lib/app/navigation.test.ts",
    "test:app-utils": "node --test src/lib/app/app-utils.test.ts",
    "test:account-contract": "node --test src/lib/account/contract.test.ts",
    "test:sync-summary": "node --test src/lib/shared/sync-summary.test.ts",
    "test:web-worker": "npm run build:web-core && node --test src/lib/web/worker-protocol.test.ts src/lib/web/worker-client.test.ts src/lib/web/database.test.ts src/lib/web/account-client.test.ts src/lib/web/catalog-client.test.ts src/lib/web/library-database.test.ts src/lib/web/library-sync.test.ts src/lib/web/blob-sync.test.ts src/lib/web/publication-metadata.test.ts src/lib/web/preferences-database.test.ts src/lib/web/taxonomy.test.ts src/lib/web/wasm-core.test.ts src/lib/reader/foliate-range-epub.test.ts",
    "generate:bindings": "cargo run --manifest-path src-tauri/Cargo.toml --bin export_bindings",
    "check:bindings": "cargo run --manifest-path src-tauri/Cargo.toml --bin export_bindings -- --check",
    "generate:tokens": "cargo run --manifest-path ../../client/app-contract/Cargo.toml --bin export_design_tokens",
    "check:tokens": "cargo run --manifest-path ../../client/app-contract/Cargo.toml --bin export_design_tokens -- --check",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test:layout-tokens": "node --test src/lib/shared/layout-tokens.test.ts",
    "test:annotation-placement": "node --test src/components/shared/readers/annotations/annotation-placement.test.ts",
    "precompress": "node scripts/precompress-dist.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@lucide/svelte": "1.31.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.6.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
