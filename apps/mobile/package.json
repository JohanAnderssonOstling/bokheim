{
  "name": "mobileapp",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "apply:vendor": "node scripts/apply-vendor-overrides.mjs",
    "predev": "npm run apply:vendor",
    "dev": "vite dev",
    "build:web-core": "node scripts/build-web-core.mjs",
    "prebuild": "npm run apply:vendor",
    "build": "npm run build:web-core && BOKHEIM_FRONTEND_OUT_DIR=dist vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:cfi": "node scripts/check-cfi-parity.mjs",
    "test:catalog": "node --test src/lib/catalog.test.ts",
    "test:semantic-links": "node --test src/lib/semantic-links.test.ts",
    "test:browsing-contract": "node --test src/lib/browsing-contract.test.ts",
    "test:account-contract": "node --test src/lib/account-contract.test.ts",
    "test:sync-summary": "node --test src/lib/sync-summary.test.ts",
    "test:web-worker": "npm run build:web-core && node --test src/lib/web/worker-protocol.test.ts src/lib/web/database.test.ts src/lib/web/account-client.test.ts src/lib/web/library-database.test.ts src/lib/web/library-sync.test.ts src/lib/web/publication-metadata.test.ts src/lib/web/preferences-database.test.ts src/lib/web/wasm-core.test.ts",
    "generate:bindings": "cargo run --manifest-path src-tauri/Cargo.toml --bin export_bindings",
    "check:bindings": "cargo run --manifest-path src-tauri/Cargo.toml --bin export_bindings -- --check",
    "generate:tokens": "cargo run --manifest-path ../../client/app-contract/Cargo.toml --bin export_design_tokens",
    "check:tokens": "cargo run --manifest-path ../../client/app-contract/Cargo.toml --bin export_design_tokens -- --check",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.6.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
