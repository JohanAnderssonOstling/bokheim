{
	email {$ACME_EMAIL}
	grace_period 35s
	servers {
		timeouts {
			read_header 10s
			read_body 2h
			write 2h
			idle 2m
		}
		max_header_size 64KB
	}
}

{$BOKHEIM_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy unix//run/bokheim/sync.sock
}

{$BOKHEIM_APP_DOMAIN:app.bokheim.se} {
	header {
		Strict-Transport-Security "max-age=31536000"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Covers the proxied API and any static file the build left without a
	# sibling. Static assets are answered from their precompressed sidecars
	# below, which is both smaller and free of per-request work.
	encode zstd gzip

	# Everything under this prefix carries a content hash, so the name changes
	# whenever the bytes do and the response never needs revalidating.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The shell names those hashed files, and the assets outside the prefix are
	# unhashed, so neither may outlive a deploy: revalidate every time and let
	# the 304 keep it cheap. Without this the browser invents its own freshness
	# and can serve an index that points at assets the release replaced.
	@revalidate not {
		path /_app/immutable/* /api/* /admin/*
	}
	header @revalidate Cache-Control "no-cache"

	handle /api/* {
		reverse_proxy unix//run/bokheim/sync.sock
	}

	redir /admin /admin/

	handle_path /admin/* {
		header {
			Cache-Control "no-store"
			Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		}
		root * /usr/local/share/bokheim-web/current/admin
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /usr/local/share/bokheim-web/current
		try_files {path} /index.html
		# `npm run build:web` writes a .br next to each artifact. Caddy serves
		# it when the client accepts brotli and falls back to the origin file
		# otherwise, where `encode` compresses on the fly.
		file_server {
			precompressed br
		}
	}
}

{$BOKHEIM_CATALOG_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy 127.0.0.1:8090
}

{$BOKHEIM_METADATA_DOMAIN:meta.bokheim.se} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	@metadata_api path /health /v1/enrichment /v2/enrichment /v2/edition-identities
	handle @metadata_api {
		reverse_proxy 127.0.0.1:8091
	}

	respond 404
}

{$BOKHEIM_TAXONOMY_DOMAIN:taxonomy.bokheim.se} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy 127.0.0.1:8093
}
