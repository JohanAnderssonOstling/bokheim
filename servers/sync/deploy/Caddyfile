{
	email {$ACME_EMAIL}
	grace_period 35s
	servers {
		timeouts {
			read_header 10s
			read_body 2h
			write 2h
			idle 2m
		}
		max_header_size 64KB
	}
}

{$BOKHEIM_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy unix//run/bokheim/sync.sock
}

{$BOKHEIM_CATALOG_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy 127.0.0.1:8090
}
