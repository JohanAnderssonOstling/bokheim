[Unit]
Description=Bokheim LC and LibraryThing metadata crawler
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=2min
StartLimitBurst=5

[Service]
Type=exec
User=johan
Group=johan
ExecStart=/usr/local/bin/metadata-server crawl /home/johan/data/openlibrary/answers-current.sqlite /var/lib/bokheim-metadata-crawl/provider.sqlite
EnvironmentFile=-/home/johan/.config/bokheim/metadata-crawl.env
StateDirectory=bokheim-metadata-crawl
StateDirectoryMode=0700
Environment=RUST_LOG=info
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_TRIM_THRESHOLD_=131072
Restart=on-failure
RestartSec=5s
TimeoutStopSec=35s
KillSignal=SIGTERM
OOMPolicy=kill
MemoryHigh=256M
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
