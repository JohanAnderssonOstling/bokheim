# Injected through CMAKE_PROJECT_INCLUDE; upstream source files remain unchanged.
function(bokheim_native_archives)
  if(NOT TARGET onnxruntime)
    message(FATAL_ERROR "Expected the ONNX Runtime interface target")
  endif()
  # Zig 0.15.2 requires EVEX512 explicitly for 512-bit intrinsics. Apply it
  # only to the kernels which upstream already compiles with AVX-512 flags;
  # the ordinary runtime and its CPU baseline remain unchanged.
  get_target_property(mlas_sources onnxruntime_mlas SOURCES)
  foreach(source IN LISTS mlas_sources)
    get_source_file_property(flags "${source}" COMPILE_FLAGS)
    if(flags MATCHES "-mavx512")
      set_property(SOURCE "${source}" APPEND PROPERTY COMPILE_OPTIONS -mevex512)
    endif()
  endforeach()
  set(pending onnxruntime)
  set(visited)
  set(archives)
  set(targets)
  while(pending)
    list(POP_FRONT pending current)
    if(current IN_LIST visited OR NOT TARGET "${current}")
      continue()
    endif()
    list(APPEND visited "${current}")
    get_target_property(kind "${current}" TYPE)
    if(kind STREQUAL "STATIC_LIBRARY")
      list(APPEND archives "$<TARGET_FILE:${current}>")
      list(APPEND targets "${current}")
    endif()
    foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(dependencies "${current}" "${property}")
      if(NOT dependencies)
        continue()
      endif()
      foreach(dependency IN LISTS dependencies)
        while(dependency MATCHES "^\\$<(LINK_ONLY|BUILD_INTERFACE|TARGET_NAME_IF_EXISTS):(.*)>$")
          set(dependency "${CMAKE_MATCH_2}")
        endwhile()
        if(dependency MATCHES "^\\$<\\$<BOOL:([^<>]*)>:(.*)>$")
          set(enabled "${CMAKE_MATCH_1}")
          set(dependency "${CMAKE_MATCH_2}")
          if(NOT enabled)
            continue()
          endif()
        endif()
        if(dependency MATCHES "^\\$<INSTALL_INTERFACE:")
          continue()
        endif()
        # Conditional system linker flags are not static archive targets.
        if(dependency MATCHES ":-[^<>]*>$")
          continue()
        endif()
        if(TARGET "${dependency}")
          list(APPEND pending "${dependency}")
        elseif(dependency MATCHES "\\$<")
          message(FATAL_ERROR "Unresolved archive dependency: ${dependency}")
        endif()
      endforeach()
    endforeach()
  endwhile()
  list(REMOVE_DUPLICATES archives)
  file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/bokheim-archives.txt"
       CONTENT "$<JOIN:${archives},\n>\n")
  add_custom_target(bokheim-onnxruntime-static DEPENDS ${targets})
endfunction()

# Project includes are called for dependency projects too; defer only at the root.
if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
  cmake_language(DEFER CALL bokheim_native_archives)
endif()
